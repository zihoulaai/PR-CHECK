# ===== 应用基础 =====
APP_ENV=dev
# Fernet 主密钥（仅部署注入，不进入数据库）。可用以下命令生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# SQLite 数据库路径（存 GitLab 连接 metadata 与 KB 文档元数据）
DATABASE_URL=sqlite:///./pr_check.db

# ===== LLM（OpenAI 兼容端点） =====
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ===== 知识库（MaaS Vector KB） =====
KB_BASE_URL=
KB_API_KEY=
KB_INDEX=

# ===== 可配置阈值（可选，留空用默认值） =====
SMALL_MAX_FILES=20
SMALL_MAX_LINES=800
MEDIUM_MAX_FILES=80
MEDIUM_MAX_LINES=3000
KB_TOP_K=5
