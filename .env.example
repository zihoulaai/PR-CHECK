# ===== 应用基础 =====
APP_ENV=dev
# SQLite 数据库路径（存 KB 文档元数据）
DATABASE_URL=sqlite:///./pr_check.db

# ===== LLM（OpenAI 兼容端点） =====
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# 推理模型是否输出思维链：留空=不发送该字段（兼容不支持的端点）；
# false=关闭（硅基流动 Qwen3.5 实测 41s/2179 tokens → 1.1s/32 tokens）
LLM_ENABLE_THINKING=

# ===== 知识库（MaaS Vector KB） =====
KB_BASE_URL=
KB_API_KEY=
KB_INDEX=

# ===== 可配置阈值（可选，留空用默认值） =====
SMALL_MAX_FILES=20
SMALL_MAX_LINES=800
MEDIUM_MAX_FILES=80
MEDIUM_MAX_LINES=3000
KB_TOP_K=5
