# ===== 应用基础 =====
APP_ENV=dev
# SQLite 数据库路径（存 KB 文档元数据）
DATABASE_URL=sqlite:///./pr_check.db

# ===== LLM（OpenAI 兼容端点） =====
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ===== 知识库（MaaS Vector KB） =====
KB_BASE_URL=
KB_API_KEY=
KB_INDEX=

# ===== 可配置阈值（可选，留空用默认值） =====
SMALL_MAX_FILES=20
SMALL_MAX_LINES=800
MEDIUM_MAX_FILES=80
MEDIUM_MAX_LINES=3000
KB_TOP_K=5
